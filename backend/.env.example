# ---------------------------------------------------------
# SiPIO Backend Environment Configuration
# ---------------------------------------------------------

# 1. Database Connection (Pilih Salah Satu):
# Option A: MySQL / MariaDB (Laragon / XAMPP):
DATABASE_URL=mysql+pymysql://root:@localhost:3306/sipio_db

# Option B: SQLite (Langsung jalan tanpa server MySQL):
# DATABASE_URL=sqlite:///./sipio.db

# 2. Broker MQTT:
# Option A: Local Mosquitto
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Option B: Cloud Broker (HiveMQ / EMQX Cloud)
# MQTT_BROKER_HOST=broker.emqx.io
# MQTT_BROKER_PORT=1883
