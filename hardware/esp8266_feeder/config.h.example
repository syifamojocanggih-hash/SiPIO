/**
 * SiPIO - Smart Fish Feeder & Pond Monitoring
 * File: config.h.example
 * Salin file ini menjadi 'config.h' lalu sesuaikan kredensial WiFi dan server Anda.
 */

#ifndef SIPIO_CONFIG_H
#define SIPIO_CONFIG_H

// -------------------------------------------------------------
// 1. Kredensial WiFi Kolam
// -------------------------------------------------------------
const char* WIFI_SSID     = "NAMA_WIFI_ANDA";
const char* WIFI_PASSWORD = "PASSWORD_WIFI_ANDA";

// -------------------------------------------------------------
// 2. Kredensial Broker MQTT SiPIO
// -------------------------------------------------------------
// Gunakan alamat IP komputer/server tempat FastAPI / Mosquitto berjalan
const char* MQTT_SERVER   = "192.168.1.100"; 
const int   MQTT_PORT     = 1883;
const char* MQTT_USER     = "";               // Kosongkan jika tanpa autentikasi
const char* MQTT_PASSWORD = "";               // Kosongkan jika tanpa autentikasi
const char* MQTT_CLIENT_ID= "sipio_esp8266_feeder";

// Topik MQTT (Sesuai Spesifikasi PRD SiPIO Versi 1.3 Bagian 11)
const char* TOPIC_TELEMETRY   = "fish/feeder01/telemetry";
const char* TOPIC_STATUS      = "fish/feeder01/status";
const char* TOPIC_COMMAND     = "fish/feeder01/cmd/feed";
const char* TOPIC_EVENT_FEED  = "fish/feeder01/event/feed";
const char* TOPIC_EVENT_SKIP  = "fish/feeder01/event/skip";
const char* TOPIC_SCHEDULES   = "fish/feeder01/cfg/schedule";
const char* TOPIC_THRESHOLDS  = "fish/feeder01/cfg/thresholds";

// -------------------------------------------------------------
// 3. Konfigurasi Pinout Perangkat Keras (NodeMCU / WeMos D1 Mini)
// Sesuai PRD Tabel 10.2
// -------------------------------------------------------------
// Sensor Suhu DS18B20 (OneWire - gunakan resistor pull-up 4.7kΩ ke 3.3V)
#define PIN_DS18B20         4   // D2 pada NodeMCU (GPIO4)

// Sensor Pelampung Air Kolam (Float Switch)
#define PIN_FLOAT_SWITCH    14  // D5 pada NodeMCU (GPIO14)
#define FLOAT_ACTIVE_LOW    true // true: pelampung terhubung ke GND saat air aman

// Motor Servo Pelet Pakan (PRD Tabel 10.2: Pin D1 / GPIO5)
// Catatan: Jika rangkaian breadboard memakai D6 (GPIO12), ubah nilai di bawah menjadi 12
#define PIN_SERVO           5   // D1 pada NodeMCU (GPIO5)

// LED Indikator Status & Aktivitas Pakan
#define PIN_LED_STATUS      2   // D4 pada NodeMCU (GPIO2 / Builtin LED)

// Parameter Ambang Pengaman Default (PRD Section 13.1)
#define DEFAULT_TEMP_MIN    24.0 // Batas bawah suhu layak makan (°C)
#define DEFAULT_TEMP_MAX    32.0 // Batas atas suhu layak makan (°C)
#define DEFAULT_MIN_GAP_MIN 30   // Jeda minimal antar pakan (menit)
// 4. Parameter Waktu & Pengaman Sistem
// -------------------------------------------------------------
#define TIMEZONE_OFFSET_HOURS 7   // Waktu Indonesia Barat (WIB = UTC+7)
#define NTP_SERVER_PRIMARY    "pool.ntp.org"
#define NTP_SERVER_BACKUP     "id.pool.ntp.org"

// Interval pembacaan & publikasi telemetri (milidetik)
#define TELEMETRY_INTERVAL_MS 5000 

// Batas durasi pakan pengaman (milidetik)
#define MIN_FEED_DURATION_MS  500
#define MAX_FEED_DURATION_MS  5000
#define DEFAULT_FEED_MS       2000

#endif // SIPIO_CONFIG_H
